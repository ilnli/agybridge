{
  "agybridge-hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "__AGYBRIDGE_HOOK_COMMAND__",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "__AGYBRIDGE_HOOK_COMMAND__",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp_agybridge_codex_.*|invoke_subagent|send_message|run_workflow",
        "hooks": [
          {
            "type": "command",
            "command": "__AGYBRIDGE_HOOK_COMMAND__",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp_agybridge_codex_.*",
        "hooks": [
          {
            "type": "command",
            "command": "__AGYBRIDGE_HOOK_COMMAND__",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "__AGYBRIDGE_HOOK_COMMAND__",
        "timeout": 10
      }
    ]
  }
}
